#!/usr/bin/env bash
# Render pi credentials and provider base URLs from nixos-secrets into a runtime directory.
# Usage: pi-render-secrets [OUT_DIR]   (default: $XDG_RUNTIME_DIR/pi)
# Decrypts through sops with the YubiKey (PIN via pinentry, touch per decrypt).
# Writes only to OUT_DIR (tmpfs under XDG_RUNTIME_DIR). Prints counts, never values.
set -euo pipefail

out="${1:-${XDG_RUNTIME_DIR:?XDG_RUNTIME_DIR is not set}/pi}"
secrets="${PI_SECRETS_FILE:-$HOME/nixos-secrets/secrets/users/glom.yaml}"
tmpl="${PI_MODELS_TEMPLATE:-$HOME/nixos-config/dotfiles/pi/agent/models.json.tmpl}"

umask 077
install -d -m 700 "$out"

data="$(mktemp -p "$out" .render.XXXXXX)"
trap 'rm -f "$data"' EXIT

sops decrypt --output-type json --extract '["pi"]' "$secrets" > "$data"
jq -e 'has("keys") and has("base_urls")' "$data" >/dev/null

# auth.json: the shape pi reads (provider -> {type, key}).
jq '{
  skillw: {type: "api_key", key: .keys.skillw},
  sub2api: {type: "api_key", key: .keys.sub2api},
  deepseek: {type: "api_key", key: .keys.deepseek}
}' "$data" > "$out/auth.json.tmp"

# models.json: the tracked template with the two base URLs filled in (no argv secrets).
jq --slurpfile d "$data" '
  .providers.skillw.baseUrl = $d[0].base_urls.skillw
 | .providers.sub2api.baseUrl = $d[0].base_urls.sub2api
' "$tmpl" > "$out/models.json.tmp"

mv -f "$out/auth.json.tmp" "$out/auth.json"
mv -f "$out/models.json.tmp" "$out/models.json"
echo "rendered 2 files into $out"
