Regression test for repositioning a popup with an inferred parent.

PR #452 (d10a015, pinned in flake.nix) now falls back to PopupData.parent
when WM_TRANSIENT_FOR is absent, so the former local source fix is no longer
needed. Retain the regression test for input-method candidate windows such
as fcitx5's, which do not set WM_TRANSIENT_FOR.

The test puts the toplevel on an output at x=500 and reconfigures a popup to
absolute x=540, expecting the parent-relative offset 40 rather than 540.

diff --git a/src/server/tests.rs b/src/server/tests.rs
--- a/src/server/tests.rs
+++ b/src/server/tests.rs
@@ -2167,6 +2167,38 @@ fn reconfigure_popup() {
     f.assert_window_dimensions(popup, p_id, new_dims);
 }
 
+#[test]
+fn reconfigure_popup_uses_inferred_parent() {
+    let (mut f, comp) = TestFixture::new_with_compositor();
+    f.new_output(0, 0);
+    let (_, output) = f.new_output(500, 0);
+    f.run();
+
+    let toplevel = Window::new(1);
+    let (_, t_id) = f.create_toplevel(&comp, toplevel);
+    f.testwl.move_surface_to_output(t_id, &output);
+    f.run();
+
+    let popup = Window::new(2);
+    let (_, p_id) = f.create_popup(&comp, PopupBuilder::new(popup, toplevel, t_id).x(520).y(40));
+
+    let new_dims = WindowDims {
+        x: 540,
+        y: 60,
+        width: 80,
+        height: 100,
+    };
+    f.reconfigure_window(popup, new_dims, true);
+    f.run();
+    f.run();
+
+    let data = f.testwl.get_surface_data(p_id).unwrap();
+    assert_eq!(
+        data.popup().positioner_state.offset,
+        testwl::Vec2 { x: 40, y: 60 }
+    );
+}
