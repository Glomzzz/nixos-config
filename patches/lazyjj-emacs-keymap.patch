diff --git a/src/ui/emacs.rs b/src/ui/emacs.rs
--- /dev/null
+++ b/src/ui/emacs.rs
@@ -0,0 +1,82 @@
+use ratatui::crossterm::event::{Event, KeyCode, KeyEvent, KeyModifiers};
+
+pub fn is_cancel(event: &Event) -> bool {
+    matches!(event, Event::Key(key)
+        if key.code == KeyCode::Char('g') && key.modifiers == KeyModifiers::CONTROL)
+}
+
+/// C-g cancels every kind of popup, including text editors and confirmations.
+pub fn cancel_event(event: Event) -> Event {
+    if is_cancel(&event) {
+        if let Event::Key(key) = event {
+            return Event::Key(KeyEvent {
+                code: KeyCode::Esc,
+                modifiers: KeyModifiers::NONE,
+                ..key
+            });
+        }
+    }
+    event
+}
+
+/// Call only after text-entry handlers: their native Emacs editing keys must
+/// never be turned into list movement, tab switching, or detail scrolling.
+pub fn navigation_key(key: KeyEvent) -> KeyEvent {
+    let code = match (key.modifiers, key.code) {
+        (KeyModifiers::CONTROL, KeyCode::Char('n')) => KeyCode::Down,
+        (KeyModifiers::CONTROL, KeyCode::Char('p')) => KeyCode::Up,
+        (KeyModifiers::CONTROL, KeyCode::Char('f')) => KeyCode::Right,
+        (KeyModifiers::CONTROL, KeyCode::Char('b')) => KeyCode::Left,
+        (KeyModifiers::CONTROL, KeyCode::Char('v')) => KeyCode::PageDown,
+        (KeyModifiers::ALT, KeyCode::Char('v')) => KeyCode::PageUp,
+        _ => return key,
+    };
+    KeyEvent {
+        code,
+        modifiers: KeyModifiers::NONE,
+        ..key
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use ratatui::crossterm::event::KeyEventKind;
+
+    #[test]
+    fn emacs_navigation_preserves_plain_actions_and_event_kind() {
+        for (modifiers, character, code) in [
+            (KeyModifiers::CONTROL, 'n', KeyCode::Down),
+            (KeyModifiers::CONTROL, 'p', KeyCode::Up),
+            (KeyModifiers::CONTROL, 'f', KeyCode::Right),
+            (KeyModifiers::CONTROL, 'b', KeyCode::Left),
+            (KeyModifiers::CONTROL, 'v', KeyCode::PageDown),
+            (KeyModifiers::ALT, 'v', KeyCode::PageUp),
+        ] {
+            let mut key = KeyEvent::new(KeyCode::Char(character), modifiers);
+            key.kind = KeyEventKind::Repeat;
+            let mapped = navigation_key(key);
+            assert_eq!(mapped.code, code);
+            assert_eq!(mapped.modifiers, KeyModifiers::NONE);
+            assert_eq!(mapped.kind, KeyEventKind::Repeat);
+
+            let plain = KeyEvent::new(KeyCode::Char(character), KeyModifiers::NONE);
+            assert_eq!(navigation_key(plain), plain);
+        }
+    }
+
+    #[test]
+    fn emacs_cancel_only_translates_control_g() {
+        let cancel = Event::Key(KeyEvent::new(KeyCode::Char('g'), KeyModifiers::CONTROL));
+        assert!(is_cancel(&cancel));
+        assert_eq!(
+            cancel_event(cancel),
+            Event::Key(KeyEvent::new(KeyCode::Esc, KeyModifiers::NONE)),
+        );
+        for modifiers in [KeyModifiers::NONE, KeyModifiers::ALT] {
+            let event = Event::Key(KeyEvent::new(KeyCode::Char('g'), modifiers));
+            assert!(!is_cancel(&event));
+            assert_eq!(cancel_event(event.clone()), event);
+        }
+    }
+}
