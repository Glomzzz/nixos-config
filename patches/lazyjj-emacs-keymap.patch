+    #[test]
+    fn emacs_text_editing_and_popup_cancellation() -> Result<()> {
+        let mut repo = TestRepo::new()?;
+        let commander = &mut repo.commander;
+        let mut app = App::new(commander.env.clone())?;
+
+        // Insert inside a command with C-b/C-f, rather than switching tabs.
+        send(&mut app, commander, plain(':'))?;
+        for character in "stats".chars() {
+            send(&mut app, commander, plain(character))?;
+        }
+        for event in [
+            ctrl('b'),
+            plain('u'),
+            ctrl('f'),
+            ctrl('n'),
+            ctrl('p'),
+            key(KeyCode::Enter, KeyModifiers::NONE),
+        ] {
+            send(&mut app, commander, event)?;
+            assert!(app.current_tab == Tab::Log);
+        }
+        assert!(
+            commander
+                .command_history
+                .lock()
+                .unwrap()
+                .iter()
+                .any(|command| command.args.first().is_some_and(|arg| arg == "status"))
+        );
+        send(&mut app, commander, ctrl('g'))?;
+        assert!(app.popup.is_none());
+
+        // Describe, revset, confirmation, help, and bookmark-selection popups.
+        for character in ['d', 'r', 'n', '?', 'b'] {
+            send(&mut app, commander, plain(character))?;
+            send(&mut app, commander, ctrl('f'))?;
+            send(&mut app, commander, ctrl('b'))?;
+            assert!(app.current_tab == Tab::Log);
+            send(&mut app, commander, ctrl('g'))?;
+            assert!(app.popup.is_none());
+            send(&mut app, commander, ctrl('f'))?;
+            assert!(app.current_tab == Tab::Files, "popup was not cancelled");
+            send(&mut app, commander, ctrl('b'))?;
+        }
+
+        // Bookmark creation and rename textareas also keep native editing.
+        commander.execute_void_jj_command(["bookmark", "create", "sample"])?;
+        app.set_tab(commander, Tab::Bookmarks)?;
+        for character in ['c', 'r'] {
