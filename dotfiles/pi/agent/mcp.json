{
  "mcpServers": {
    "tauri": {
      "command": "npx",
      "args": [
        "-y",
        "@hypothesi/tauri-mcp-server"
      ]
    },
    "phonedriver": {
      "command": "phonedriver",
      "args": [
        "mcp"
      ],
      "env": {
        "PHONEDRIVER_DISPLAY": "hidden"
      },
      "enabled": false
    }
  }
}
