{
    "label": "lock",
    "action": "qs ipc call lock open",
    "text": "锁定",
    "keybind": "l"
}

{
    "label": "logout",
    "action": "niri msg action quit --skip-confirmation",
    "text": "退出",
    "keybind": "e"
}

{
    "label": "suspend",
    "action": "qs ipc call lock open && systemctl suspend",
    "text": "挂起",
    "keybind": "u"
}

{
    "label": "shutdown",
    "action": "systemctl poweroff",
    "text": "关机",
    "keybind": "s"
}

{
    "label": "hibernate",
    "action": "qs ipc call lock open && systemctl hibernate",
    "text": "休眠",
    "keybind": "h"
}

{
    "label": "reboot",
    "action": "systemctl reboot",
    "text": "重启",
    "keybind": "r"
}
