{
    "label": "lock",
    "action": "clavis-shell ipc call lock open",
    "text": "Lock",
    "keybind": "l"
}

{
    "label": "logout",
    "action": "niri msg action quit --skip-confirmation",
    "text": "Log Out",
    "keybind": "e"
}

{
    "label": "shutdown",
    "action": "systemctl poweroff",
    "text": "Shut Down",
    "keybind": "s"
}

{
    "label": "reboot",
    "action": "systemctl reboot",
    "text": "Restart",
    "keybind": "r"
}
