#!/usr/bin/env bash

set -u

mock_state="${CLAVIS_AWWW_MOCK_STATE:-/tmp/clavis-awww-mock-${UID}}"
mock_log="${mock_state}.log"

if [[ "${1:-}" == "--version" ]]; then
    printf '%s\n' "awww-daemon 0.12.1-mock"
    exit 0
fi

cleanup() {
    rm -f "${mock_state}.pid" "${mock_state}.socket"
}

shutdown() {
    cleanup
    exit 0
}

trap cleanup EXIT
trap shutdown INT TERM

printf '%s\n' "$$" > "${mock_state}.pid"
: > "${mock_state}.socket"
printf 'daemon' >> "${mock_log}"
printf ' %q' "$@" >> "${mock_log}"
printf '\n' >> "${mock_log}"

while true; do
    sleep 0.1
done
