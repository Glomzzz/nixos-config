// Generated themes and Clavis-managed effects must remain writable.
include optional=true "colors.kdl"
include optional=true "clavis-effects.kdl"
include optional=true "dms/cursor.kdl"
include optional=true "xwayland-satellite.kdl"

input {
    keyboard {
        xkb {
            layout "us"
            options "ctrl:nocaps"
        }
        numlock
    }

    touchpad {
        tap
        natural-scroll
    }

    mouse {
        accel-profile "flat"
    }

    focus-follows-mouse max-scroll-amount="0%"
}

output "eDP-1" {
    mode "2560x1600@240.001"
    scale 1.5
    position x=0 y=0
    focus-at-startup
    variable-refresh-rate on-demand=true
}

output "HDMI-A-1" {
    mode "1920x1080@60"
    scale 1
    // 2560 / 1.5 rounds to a 1707-pixel logical laptop width.
    position x=1707 y=0
}

workspace "1" {
    open-on-output "eDP-1"
}

workspace "2" {
    open-on-output "HDMI-A-1"
}

workspace "3"
workspace "4"
workspace "5"
workspace "6"
workspace "7"
workspace "8"
workspace "9"
workspace "10"

layout {
    gaps 10
    center-focused-column "on-overflow"
    background-color "transparent"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        width 2
        active-color "#89dceb"
        inactive-color "#585b70aa"
        urgent-color "#f38ba8"
    }

    border {
        off
    }

    shadow {
        on
        softness 24
        spread 3
        offset x=0 y=5
        color "#00000088"
    }
}

prefer-no-csd

cursor {
    xcursor-theme "breeze_cursors"
    xcursor-size 24
}

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

hotkey-overlay {
    skip-at-startup
}

blur {
    passes 3
    offset 3
    noise 0.02
    saturation 1.3
}

layer-rule {
    match namespace="^clavis-overview-wallpaper$"
    place-within-backdrop true
}

window-rule {
    geometry-corner-radius 6
    clip-to-geometry true
}

// Keep the Steam client and game surfaces on the high-refresh laptop panel.
window-rule {
    match app-id=r#"(?i)^(steam|steamwebhelper)$"#
    open-on-output "eDP-1"
}

// Route games to the high-refresh laptop panel. Let each game negotiate its
// own fullscreen geometry so Xwayland keeps rendering and input coordinates
// aligned.
window-rule {
    match app-id=r#"(?i)^(steam_app_[0-9]+|dota2|cs2|gamescope|\.gamescope-wrapped)$"#
    open-on-output "eDP-1"
    variable-refresh-rate true
    geometry-corner-radius 0
    clip-to-geometry false
    shadow {
        off
    }
}

window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

binds {
    Mod+Shift+Slash { show-hotkey-overlay; }

    Mod+Return hotkey-overlay-title="Open Terminal" { spawn "kitty"; }
    Mod+C hotkey-overlay-title="Open Editor" { spawn "emacsclient" "-c" "-a" "emacs"; }
    Mod+E hotkey-overlay-title="Open Files" { spawn "dolphin"; }
    Mod+Space repeat=false hotkey-overlay-title="Spotlight" { spawn "clavis-shell" "ipc" "call" "spotlight" "toggle"; }
    Ctrl+Space repeat=false hotkey-overlay-title="Spotlight" { spawn "clavis-shell" "ipc" "call" "spotlight" "toggle"; }
    Mod+V repeat=false hotkey-overlay-title="Clipboard" { spawn "clavis-shell" "ipc" "call" "spotlight" "openMode" "clipboard"; }

    Mod+Q repeat=false { close-window; }
    Mod+T repeat=false { toggle-window-floating; }
    Mod+F repeat=false { fullscreen-window; }
    Mod+Shift+M repeat=false { quit; }
    Mod+O repeat=false { toggle-overview; }

    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up    { focus-window-up; }
    Mod+Down  { focus-window-down; }

    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Up    { move-window-up; }
    Mod+Shift+Down  { move-window-down; }

    Mod+Ctrl+Left  { set-column-width "-5%"; }
    Mod+Ctrl+Right { set-column-width "+5%"; }
    Mod+Ctrl+Up    { set-window-height "-5%"; }
    Mod+Ctrl+Down  { set-window-height "+5%"; }

    Mod+1 { focus-workspace "1"; }
    Mod+2 { focus-workspace "2"; }
    Mod+3 { focus-workspace "3"; }
    Mod+4 { focus-workspace "4"; }
    Mod+5 { focus-workspace "5"; }
    Mod+6 { focus-workspace "6"; }
    Mod+7 { focus-workspace "7"; }
    Mod+8 { focus-workspace "8"; }
    Mod+9 { focus-workspace "9"; }
    Mod+0 { focus-workspace "10"; }

    Mod+Shift+1 { move-column-to-workspace "1"; }
    Mod+Shift+2 { move-column-to-workspace "2"; }
    Mod+Shift+3 { move-column-to-workspace "3"; }
    Mod+Shift+4 { move-column-to-workspace "4"; }
    Mod+Shift+5 { move-column-to-workspace "5"; }
    Mod+Shift+6 { move-column-to-workspace "6"; }
    Mod+Shift+7 { move-column-to-workspace "7"; }
    Mod+Shift+8 { move-column-to-workspace "8"; }
    Mod+Shift+9 { move-column-to-workspace "9"; }
    Mod+Shift+0 { move-column-to-workspace "10"; }

    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp cooldown-ms=150 { focus-workspace-up; }

    Print { screenshot; }
    Mod+Print { screenshot-screen; }
    Mod+Shift+S { screenshot; }

    XF86AudioRaiseVolume allow-when-locked=true { spawn "wpctl" "set-volume" "-l" "1" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86AudioMicMute allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }

    XF86MonBrightnessUp allow-when-locked=true { spawn "brightnessctl" "-e4" "-n2" "set" "5%+"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "-e4" "-n2" "set" "5%-"; }

    XF86AudioNext allow-when-locked=true { spawn "playerctl" "next"; }
    XF86AudioPause allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioPlay allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioPrev allow-when-locked=true { spawn "playerctl" "previous"; }

    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
}
